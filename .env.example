# Copy this file to .env. Values here are examples only; never commit .env.
DJANGO_SECRET_KEY=replace-with-a-unique-long-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///var/cybertwin.sqlite3

# This directory must be outside any public static/media serving path.
EVIDENCE_STORAGE_ROOT=var/evidence
REPORT_STORAGE_ROOT=var/reports

# Phase 5 upload policy: enforce in application code, not only at the UI.
MAX_EVIDENCE_UPLOAD_BYTES=10485760
ALLOWED_EVIDENCE_CONTENT_TYPES=application/pdf,image/jpeg,image/png,text/plain

